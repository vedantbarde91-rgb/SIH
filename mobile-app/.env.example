# ─── NER-LEWS Mobile App — Environment Variables ───────────────────────────
#
# Copy this file to .env and fill in your values before running.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ──────────────────────────────────────────────────────────
#
# FOR LOCAL DEMO (phone + laptop on same WiFi):
#   1. Find your laptop's local IP:
#      Windows: open cmd → ipconfig → look for IPv4 Address (e.g. 192.168.1.5)
#   2. Set it below (keep port 8000):
#
VITE_API_BASE_URL=http://192.168.1.5:8000/api
#
# FOR CLOUD DEPLOYMENT (phone anywhere):
#   Set to your deployed backend URL, e.g.:
#   VITE_API_BASE_URL=https://ner-lews-api.onrender.com/api

# ── Firebase Configuration (optional — app works in prototype mode without it)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
